# Copy this file to .env and fill in real values before running the app
# (natively or via Docker). Never commit the real .env (it's gitignored).

# Needed only for the Q&A and Benchmark tabs; Board and SPICE Simulation
# work without it.
GEMINI_API_KEY=your-key-here

# Optional: defaults to gemini-3.8-flash if unset.
# GEMINI_MODEL=gemini-3.8-flash

# Optional: defaults to "ngspice" (resolved via PATH). The Docker image
# already installs ngspice on PATH, so this is normally only needed for a
# native (non-Docker) run with a non-standard install location.
# NGSPICE_PATH=ngspice

# Optional: only needed for core.kicad_cli_helpers.KiCadInterface, which is
# not used by the bundled Boards/ (they already ship pre-exported .net/.cir
# files). Set this only if you want to regenerate those from raw KiCad
# schematic/project files using kicad-cli.
# KICAD_CLI_PATH=/path/to/kicad-cli
